{
    "java.compile.nullAnalysis.mode": "automatic",

    "files.watcherExclude": {
        "**/.git/**": true,
        "**/target/**": true,
        "**/node_modules/**": true,
        "**/.idea/**": true,
        "**/.vscode/**": true
    },

    "files.exclude": {
        "**/target": true,
        "**/node_modules": true
    },

    "search.exclude": {
        "**/target": true,
        "**/node_modules": true
    },

    "java.project.resourceFilters": [
        "node_modules",
        "target",
        ".git"
    ]
}