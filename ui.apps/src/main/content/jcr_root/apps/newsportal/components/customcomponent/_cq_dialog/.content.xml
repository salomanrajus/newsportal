<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0"
	xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
	xmlns:cq="http://www.day.com/jcr/cq/1.0"
	xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
	jcr:primaryType="nt:unstructured"
	jcr:title="Custom Component Properties"
	sling:resourceType="cq/gui/components/authoring/dialog">
	<content jcr:primaryType="nt:unstructured"
		sling:resourceType="granite/ui/components/coral/foundation/container">
		<items jcr:primaryType="nt:unstructured">
			<tabs jcr:primaryType="nt:unstructured"
				sling:resourceType="granite/ui/components/coral/foundation/tabs">
				<items jcr:primaryType="nt:unstructured">
					<basic jcr:primaryType="nt:unstructured"
						sling:resourceType="granite/ui/components/coral/foundation/container"
						jcr:title="Basic">
						<items jcr:primaryType="nt:unstructured">
							<title jcr:primaryType="nt:unstructured"
								sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
								fieldLabel="Title" name="./title" />
							<description jcr:primaryType="nt:unstructured"
								fieldLabel="Description"
								sling:resourceType="cq/gui/components/authoring/dialog/richtext"
								name="./description" useFixedInlineToolbar="{Boolean}true" />
						</items>
					</basic>
					<advanced jcr:primaryType="nt:unstructured"
						sling:resourceType="granite/ui/components/coral/foundation/container"
						jcr:title="Advanced">
						<items jcr:primaryType="nt:unstructured">
							<accordion jcr:primaryType="nt:unstructured"
								sling:resourceType="granite/ui/components/coral/foundation/accordion">
								<items jcr:primaryType="nt:unstructured">
									<colors jcr:primaryType="nt:unstructured"
										sling:resourceType="granite/ui/components/coral/foundation/container"
										jcr:title="Colors">
										<items jcr:primaryType="nt:unstructured">
											<descriptionTextColor
												jcr:primaryType="nt:unstructured"
												sling:resourceType="granite/ui/components/coral/foundation/form/select"
												fieldLabel="Description Text color"
												name="./descriptionTextColor">

												<items jcr:primaryType="nt:unstructured">

													<black jcr:primaryType="nt:unstructured" text="Black"
														value="#000000" />

													<darkGray jcr:primaryType="nt:unstructured"
														text="Dark Gray" value="#374151" />

													<darkBlue jcr:primaryType="nt:unstructured"
														text="Dark Blue" value="#1E3A8A" />

													<darkGreen jcr:primaryType="nt:unstructured"
														text="Dark Green" value="#166534" />
												</items>
											</descriptionTextColor>
											<descriptionBackgroundColor
												jcr:primaryType="nt:unstructured"
												sling:resourceType="granite/ui/components/coral/foundation/form/select"
												fieldLabel="Description Background Color"
												name="./descriptionBackgroundColor">
												<items jcr:primaryType="nt:unstructured">

													<lightYellow jcr:primaryType="nt:unstructured"
														text="Light Yellow" value="#FEF3C7" />

													<lightBlue jcr:primaryType="nt:unstructured"
														text="Light Blue" value="#DBEAFE" />

													<lightGreen jcr:primaryType="nt:unstructured"
														text="Light Green" value="#DCFCE7" />

													<lightGray jcr:primaryType="nt:unstructured"
														text="Light Gray" value="#E5E7EB" />

												</items>
											</descriptionBackgroundColor>
										</items>
									</colors>
								</items>
							</accordion>
						</items>
					</advanced>
					<pro jcr:primaryType="nt:unstructured"
						sling:resourceType="granite/ui/components/coral/foundation/container"
						jcr:title="Pro">
						<items jcr:primaryType="nt:unstructured">
							<images jcr:primaryType="nt:unstructured"
								sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
								fieldLabel="Images" composite="{Boolean}false">
								<field jcr:primaryType="nt:unstructured"
									sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
									fieldLabel="Image" name="./images" rootPath="/content/dam/newsportal/luxery-images" />
							</images>

							<videos jcr:primaryType="nt:unstructured"
								sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
								fieldLabel="Videos" composite="{Boolean}false">
								<field jcr:primaryType="nt:unstructured"
									sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
									fieldLabel="Video" name="./videos" rootPath="/content/dam/newsportal/luxery-videos" />
							</videos>
						</items>
					</pro>
				</items>
			</tabs>
		</items>
	</content>
</jcr:root>